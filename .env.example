# Generate at https://login.tailscale.com/admin/settings/keys (reusable not needed).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Where daily database backups go on this machine (default: ./backups).
# BACKUP_HOST_DIR=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Tempo Backups

# The address people open Tempo at; password reset links point here.
APP_URL=https://ember.your-tailnet.ts.net

# Password reset email through Gmail. Create an app password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on), then
# put your Gmail address and that 16-letter password here. Leave both unset and
# reset links are written to the app's log instead (docker compose logs app).
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
